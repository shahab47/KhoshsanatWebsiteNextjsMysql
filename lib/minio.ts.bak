// مسیر فایل: src/lib/minio.ts
import { S3Client, PutObjectCommand, DeleteObjectCommand, ListObjectsV2Command } from "@aws-sdk/client-s3";

console.log("----------------------------------------------------------------------");
console.log("⚙️ [MINIO_INIT]: در حال مقداردهی اولیه پیکربندی کامپوننت متصل‌کننده S3...");
console.log("----------------------------------------------------------------------");

const isDev = process.env.NODE_ENV === 'development';

// تمامی اطلاعات اکیداً از .env خوانده می‌شود
const endpointFromEnv = process.env.MINIO_ENDPOINT || "127.0.0.1:9000";
const [host, port] = endpointFromEnv.split(':');
const protocol = process.env.MINIO_USE_SSL === "true" ? "https" : "http";
const minioEndpoint = `${protocol}://${host}:${port}`;
const bucketName = process.env.MINIO_BUCKET_NAME || "khoshsanat-media";

const publicBaseUrl = isDev
  ? `http://localhost:${port}`
  : (process.env.NEXT_PUBLIC_SITE_URL || "https://khoshsanat.ir");

export const s3Client = new S3Client({
  region: "us-east-1",
  endpoint: minioEndpoint,
  forcePathStyle: true,
  credentials: {
    accessKeyId: process.env.MINIO_ACCESS_KEY || "",
    secretAccessKey: process.env.MINIO_SECRET_KEY || "",
  },
});

export async function uploadToMinio(fileBuffer: Buffer, fileName: string, folderName: string, mimeType: string) {
  const fullPath = `${folderName}/${fileName}`;
  const command = new PutObjectCommand({
    Bucket: bucketName,
    Key: fullPath,
    Body: fileBuffer,
    ContentType: mimeType,
  });

  try {
    await s3Client.send(command);
    
    // در محیط Production عکس از مسیر Nginx و در Dev از Localhost باز می‌شود
    let generatedUrl = isDev 
        ? `${publicBaseUrl}/${bucketName}/${fullPath}`
        : `${publicBaseUrl.replace(/\/$/, '')}/minio/${bucketName}/${fullPath}`;

    return generatedUrl;
  } catch (error: any) {
    console.error("❌❌❌ [UPLOAD_FUNC_CRITICAL_ERROR]: ", error.message);
    throw error;
  }
}

export async function deleteFromMinio(fileUrl: string) {
  if (!fileUrl) return;

  try {
    let fileKey: string | undefined;
    const parsedUrl = new URL(fileUrl);
    const pathname = parsedUrl.pathname; 
    const targetSegment = `/${bucketName}/`;
    
    if (pathname.includes(targetSegment)) {
      fileKey = pathname.split(targetSegment)[1];
    }

    if (!fileKey) return;
    fileKey = decodeURIComponent(fileKey);

    const command = new DeleteObjectCommand({
      Bucket: bucketName,
      Key: fileKey,
    });

    await s3Client.send(command);
  } catch (error: any) {
    console.error("❌ [DELETE_FUNC_ERROR]: ", error.message);
  }
}

export async function listMinioObjects(prefix: string = '', recursive: boolean = false): Promise<any[]> {
  const objects: any[] = [];
  try {
    const command = new ListObjectsV2Command({
      Bucket: bucketName,
      Prefix: prefix,
      Delimiter: recursive ? undefined : '/',
    });
    const response = await s3Client.send(command);

    if (!recursive && response.CommonPrefixes) {
      response.CommonPrefixes.forEach(p => {
        if (p.Prefix) objects.push({ prefix: p.Prefix });
      });
    }

    if (response.Contents) {
      response.Contents.forEach(c => {
        if (c.Key && c.Key !== prefix) {
          const objectUrl = isDev
            ? `${publicBaseUrl}/${bucketName}/${c.Key}`
            : `${publicBaseUrl.replace(/\/$/, '')}/minio/${bucketName}/${c.Key}`;

          objects.push({
            name: c.Key,
            size: c.Size,
            lastModified: c.LastModified,
            url: objectUrl,
          });
        }
      });
    }
    return objects;
  } catch (error: any) {
    throw error;
  }
}