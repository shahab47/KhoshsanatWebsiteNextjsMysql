// مسیر فایل: prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String
  role          String    @default("CONTENT_ADMIN")
  allowedPaths  String?   // مثل "/khoshmin/products,/khoshmin/customers"
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customerNotes CustomerNote[]
}

model Slide {
  id               Int       @id @default(autoincrement())
  imageUrl         String
  size             Int?      // حجم فایل به بایت
  title            String?
  subtitle         String?
  titleColor       String?   @default("#ffffff")
  titleFontSize    String?   @default("3rem")
  subtitleColor    String?   @default("#d1d5db")
  subtitleFontSize String?   @default("1.25rem")
  order            Int       @default(0)
  isActive         Boolean   @default(true)
  type             SlideType @default(MAIN)
  createdAt        DateTime  @default(now())
}

model SliderSettings {
  id             Int      @id @default(1)
  heightDesktop  String?  @default("85vh")
  heightMobile   String?  @default("60vh")
  overlayColor   String?  @default("#000000")
  overlayOpacity Float?   @default(0.7)
  updatedAt      DateTime @updatedAt
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.LongText
}

model Category {
  id            Int           @id @default(autoincrement())
  title         String
  slug          String        @unique
  icon          String?
  imageUrl      String?       // آدرس تصویر دسته‌بندی (اختیاری)
  imageSize     Int?          // حجم تصویر به بایت
  
  gallery       Json?         // 🟢 اضافه شد: برای گالری تصاویر دسته‌بندی
  catalogUrl    String?       // 🟢 اضافه شد: برای کاتالوگ PDF دسته‌بندی

  order         Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories Subcategory[]
}

model Subcategory {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  categoryId  Int
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products    Product[]
}

model Product {
  id            Int         @id @default(autoincrement())
  title         String
  slug          String      @unique
  description   String      @db.Text
  shortDesc     String?
  imageUrl      String
  gallery       Json?       
  
  catalogUrl    String?     // 🟢 اضافه شد: برای کاتالوگ PDF محصول

  subcategoryId Int
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  order         Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ArticleCategory {
  id        Int      @id @default(autoincrement())
  title     String   @unique
  createdAt DateTime @default(now())
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  excerpt   String?  @db.Text
  content   String   @db.LongText
  category  String?  
  author    String?
  readTime  Int?
  imageUrl  String
  media     Json?    // فیلد جدید برای ذخیره گالری
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  category  String?
  location  String?
  content   String   @db.LongText
  size      String   @default("normal")
  imageUrl  String
  gallery   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectCategory {
  id        Int      @id @default(autoincrement())
  title     String   @unique
  createdAt DateTime @default(now())
}

model Logo {
  id    Int    @id @default(autoincrement())
  type  String @unique
  url   String
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String   @db.LongText
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id                  Int               @id @default(autoincrement())
  name                String
  email               String            @unique
  phone               String?
  address             String?           @db.Text
  company             String?
  nationalId          String?           @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  messages            CustomerMessage[]
  invoices            Invoice[]
  payments            Payment[]
  deliveries          Delivery[]
  notes               CustomerNote[]
  totalDebt           Float             @default(0)
  totalPaid           Float             @default(0)
  status              CustomerStatus    @default(ACTIVE)
  isViewedByAdmin     Boolean           @default(false)
  unreadMessagesCount Int               @default(0)
}

model CustomerMessage {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subject    String
  message    String   @db.LongText
  isRead     Boolean  @default(false)
  adminReply String?  @db.LongText
  createdAt  DateTime @default(now())
}

model CustomerNote {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  adminId    Int?
  admin      User?    @relation(fields: [adminId], references: [id])
  note       String   @db.LongText
  createdAt  DateTime @default(now())
  isNew      Boolean  @default(true)
}

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNo     String        @unique
  customerId    Int
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount        Float
  discount      Float         @default(0)
  tax           Float         @default(0)
  finalAmount   Float
  description   String?       @db.Text
  status        InvoiceStatus @default(PENDING)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  paidAmount    Float         @default(0)
  attachmentUrl String?       // اضافه شد برای آپلود فایل فاکتور
  payments      Payment[]
  items         InvoiceItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  title     String
  quantity  Float
  unitPrice Float
  total     Float
}

model Payment {
  id            Int           @id @default(autoincrement())
  customerId    Int
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId     Int?
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  amount        Float
  paymentDate   DateTime      @default(now())
  paymentMethod PaymentMethod @default(CASH)
  receiptNo     String?
  description   String?       @db.Text
  attachmentUrl String?       // اضافه شد برای آپلود رسید/فیش
}

model Delivery {
  id           Int            @id @default(autoincrement())
  deliveryNo   String         @unique
  customerId   Int
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productName  String
  quantity     Float
  unit         String?
  deliveryDate DateTime       @default(now())
  status       DeliveryStatus @default(PENDING)
  description  String?        @db.Text
  signatureUrl String?
  attachments  Json?
}

enum SlideType {
  MAIN
  PRODUCT
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  LEAD
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CHECK
  CARD
  TRANSFER
  OTHER
}

enum DeliveryStatus {
  PENDING
  PREPARING
  DELIVERED
  RETURNED
}

model VisitLog {
  id             Int      @id @default(autoincrement())
  path           String   @db.VarChar(500)
  referrer       String?  @db.VarChar(1000)
  referrerSource String?  @db.VarChar(100) // مثل Google, Instagram, Telegram, Direct, Torob
  ip             String?  @db.VarChar(100)
  city           String?  @db.VarChar(100) // شهر (مثلا تهران، اصفهان، مشهد)
  country        String?  @db.VarChar(100) // نام کشور
  countryCode    String?  @db.VarChar(10)  // کد کشور (IR, etc.)
  device         String?  @db.VarChar(50)  // mobile, desktop, tablet
  browser        String?  @db.VarChar(50)  // Chrome, Safari, Firefox, Edge
  os             String?  @db.VarChar(50)  // Windows, Android, iOS, macOS, Linux
  userAgent      String?  @db.Text
  sessionHash    String?  @db.VarChar(100)
  isBot          Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([referrerSource])
  @@index([city])
}

model EmailLog {
  id           Int      @id @default(autoincrement())
  senderId     Int?
  senderEmail  String   @db.VarChar(255)
  senderName   String?  @db.VarChar(255)
  recipient    String   @db.VarChar(255)
  subject      String   @db.VarChar(500)
  body         String   @db.LongText
  status       String   @default("SENT") @db.VarChar(50) // SENT, FAILED
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
  customerId   Int?

  @@index([createdAt])
  @@index([recipient])
  @@index([senderEmail])
}