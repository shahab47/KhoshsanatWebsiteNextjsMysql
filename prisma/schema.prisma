// مسیر فایل: prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int         @id @default(autoincrement())
  name          String
  email         String      @unique
  password      String
  role          String      @default("CONTENT_ADMIN")
  status        UserStatus  @default(PENDING)
  allowedPaths  String?     // مثل "/khoshmin/products,/khoshmin/customers"
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customerNotes CustomerNote[]
}

model Slide {
  id               Int       @id @default(autoincrement())
  imageUrl         String
  size             Int?      // حجم فایل به بایت
  title            String?
  subtitle         String?
  titleColor       String?   @default("#ffffff")
  titleFontSize    String?   @default("3rem")
  subtitleColor    String?   @default("#d1d5db")
  subtitleFontSize String?   @default("1.25rem")
  order            Int       @default(0)
  isActive         Boolean   @default(true)
  type             SlideType @default(MAIN)
  createdAt        DateTime  @default(now())
}

model SliderSettings {
  id             Int      @id @default(1)
  heightDesktop  String?  @default("85vh")
  heightMobile   String?  @default("60vh")
  overlayColor   String?  @default("#000000")
  overlayOpacity Float?   @default(0.7)
  updatedAt      DateTime @updatedAt
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.LongText
}

model Category {
  id            Int           @id @default(autoincrement())
  title         String
  slug          String        @unique
  icon          String?
  imageUrl      String?       // آدرس تصویر دسته‌بندی (اختیاری)
  imageSize     Int?          // حجم تصویر به بایت
  
  gallery       Json?         // 🟢 اضافه شد: برای گالری تصاویر دسته‌بندی
  catalogUrl    String?       // 🟢 اضافه شد: برای کاتالوگ PDF دسته‌بندی

  order         Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories Subcategory[]
}

model Subcategory {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  categoryId  Int
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products    Product[]
}

model Product {
  id            Int         @id @default(autoincrement())
  title         String
  slug          String      @unique
  description   String      @db.Text
  shortDesc     String?
  imageUrl      String
  gallery       Json?       
  
  catalogUrl    String?     // 🟢 اضافه شد: برای کاتالوگ PDF محصول

  subcategoryId Int
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  order         Int         @default(0)
  isActive      Boolean     @default(true)

  // بخش حسابداری صنعتی، انبارداری و سامانه مودیان
  code          String?            @unique // کد کالا یا ماده اولیه در انبار
  taxStuffId    String?            // شناسه کالا/خدمت ۱۳ رقمی سامانه مودیان
  unit          String?            @default("عدد") // عدد، کیلوگرم، شاخه، تن، متر
  unitWeightKg  Decimal?           @db.Decimal(12, 3) // وزن محاسباتی استاندارد جهت تطابق با باسکول
  isRawMaterial Boolean            @default(false)
  boms          BOM[]              @relation("ProductBOM")
  usedInBom     BOMItem[]
  stockTxns     StockTransaction[]
  invoiceItems  InvoiceItem[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ArticleCategory {
  id        Int      @id @default(autoincrement())
  title     String   @unique
  createdAt DateTime @default(now())
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  excerpt   String?  @db.Text
  content   String   @db.LongText
  category  String?  
  author    String?
  readTime  Int?
  imageUrl  String
  media     Json?    // فیلد جدید برای ذخیره گالری
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  category  String?
  location  String?
  content   String   @db.LongText
  size      String   @default("normal")
  imageUrl  String
  gallery   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectCategory {
  id        Int      @id @default(autoincrement())
  title     String   @unique
  createdAt DateTime @default(now())
}

model Logo {
  id    Int    @id @default(autoincrement())
  type  String @unique
  url   String
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String   @db.LongText
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id                  Int               @id @default(autoincrement())
  name                String
  email               String            @unique
  phone               String?
  address             String?           @db.Text
  company             String?
  nationalId          String?           @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  messages            CustomerMessage[]
  invoices            Invoice[]
  payments            Payment[]
  deliveries          Delivery[]
  notes               CustomerNote[]
  totalDebt           Float             @default(0)
  totalPaid           Float             @default(0)
  status              CustomerStatus    @default(ACTIVE)
  isViewedByAdmin     Boolean           @default(false)
  unreadMessagesCount Int               @default(0)

  // اطلاعات تکمیلی مالیاتی و مهندسی ساخت
  economicCode        String?           // کد اقتصادی ۱۲ رقمی
  postalCode          String?
  productionOrders    ProductionOrder[]
}

model CustomerMessage {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subject    String
  message    String   @db.LongText
  isRead     Boolean  @default(false)
  adminReply String?  @db.LongText
  createdAt  DateTime @default(now())
}

model CustomerNote {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  adminId    Int?
  admin      User?    @relation(fields: [adminId], references: [id])
  note       String   @db.LongText
  createdAt  DateTime @default(now())
  isNew      Boolean  @default(true)
}

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNo     String        @unique
  customerId    Int
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount        Float
  discount      Float         @default(0)
  tax           Float         @default(0)
  finalAmount   Float
  description   String?       @db.Text
  status        InvoiceStatus @default(PENDING)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  paidAmount    Float         @default(0)
  attachmentUrl String?       @db.Text // اضافه شد برای آپلود فایل فاکتور
  payments      Payment[]
  items         InvoiceItem[]

  // فیلدهای مالیاتی سامانه مودیان کشور
  taxId              String?         @unique // شماره ۲۲ رقمی منحصر‌به‌فرد مالیاتی
  taxInternalSerial  Int?            // شماره سریال تصاعدی حافظه مالیاتی
  taxStatus          TaxSendStatus   @default(NOT_SENT)
  taxRefId           String?         // TaxID مرجع جهت فاکتورهای ابطالی/اصلاحی
  taxPacketUid       String?         // کد رهگیری استعلام بسته
  taxErrorLog        String?         @db.Text

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([taxId])
}

model InvoiceItem {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id])
  title     String
  quantity  Float
  unitPrice Float
  discount  Float    @default(0)
  taxRate   Decimal  @default(0.10) @db.Decimal(5, 4) // نرخ مالیات بر ارزش افزوده سال جاری
  taxAmount Decimal  @default(0) @db.Decimal(18, 2)
  total     Float
}

model Payment {
  id            Int           @id @default(autoincrement())
  customerId    Int
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId     Int?
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  amount        Float
  paymentDate   DateTime      @default(now())
  paymentMethod PaymentMethod @default(CASH)
  receiptNo     String?
  description   String?       @db.Text
  attachmentUrl String?       @db.Text // اضافه شد برای آپلود رسید/فیش
}

model Delivery {
  id           Int            @id @default(autoincrement())
  deliveryNo   String         @unique
  customerId   Int
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productName  String
  quantity     Float
  unit         String?
  deliveryDate DateTime       @default(now())
  status       DeliveryStatus @default(PENDING)
  description  String?        @db.Text
  signatureUrl String?
  attachments  Json?
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum SlideType {
  MAIN
  PRODUCT
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  LEAD
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CHECK
  CARD
  TRANSFER
  OTHER
}

enum DeliveryStatus {
  PENDING
  PREPARING
  DELIVERED
  RETURNED
}

model VisitLog {
  id             Int      @id @default(autoincrement())
  path           String   @db.VarChar(500)
  referrer       String?  @db.VarChar(1000)
  referrerSource String?  @db.VarChar(100) // مثل Google, Instagram, Telegram, Direct, Torob
  ip             String?  @db.VarChar(100)
  city           String?  @db.VarChar(100) // شهر (مثلا تهران، اصفهان، مشهد)
  country        String?  @db.VarChar(100) // نام کشور
  countryCode    String?  @db.VarChar(10)  // کد کشور (IR, etc.)
  device         String?  @db.VarChar(50)  // mobile, desktop, tablet
  browser        String?  @db.VarChar(50)  // Chrome, Safari, Firefox, Edge
  os             String?  @db.VarChar(50)  // Windows, Android, iOS, macOS, Linux
  userAgent      String?  @db.Text
  sessionHash    String?  @db.VarChar(100)
  isBot          Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([referrerSource])
  @@index([city])
}

model EmailLog {
  id           Int      @id @default(autoincrement())
  senderId     Int?
  senderEmail  String   @db.VarChar(255)
  senderName   String?  @db.VarChar(255)
  recipient    String   @db.VarChar(255)
  subject      String   @db.VarChar(500)
  body         String   @db.LongText
  status       String   @default("SENT") @db.VarChar(50) // SENT, FAILED
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
  customerId   Int?

  @@index([createdAt])
  @@index([recipient])
  @@index([senderEmail])
}

// ===========================================================
// لایه حسابداری مالی دوبل و دفاتر قانونی (روزنامه و کل)
// ===========================================================

enum AccountNature {
  DEBIT
  CREDIT
}

model Account {
  id             String          @id @default(uuid())
  code           String          @unique // کد حساب (مثلاً 110201)
  name           String
  level          Int             // 1: گروه, 2: کل, 3: معین
  nature         AccountNature
  parentId       String?
  parent         Account?        @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       Account[]       @relation("AccountHierarchy")
  journalEntries JournalEntry[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([code])
}

enum VoucherStatus {
  DRAFT
  VERIFIED
  FINALIZED
}

model JournalVoucher {
  id              String         @id @default(uuid())
  voucherNo       Int            @unique // شماره تصاعدی سند حسابداری
  voucherDate     DateTime
  description     String         @db.Text
  status          VoucherStatus  @default(DRAFT)
  referenceModule String?        // SALES, PRODUCTION, PAYROLL, WAREHOUSE
  referenceId     String?        // شناسه رخداد مبدا جهت تطبیق
  entries         JournalEntry[]
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([voucherDate])
}

model JournalEntry {
  id          String         @id @default(uuid())
  voucherId   String
  voucher     JournalVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account        @relation(fields: [accountId], references: [id])
  detail1Id   String?        // تفصیلی اشخاص، مشتریان یا تامین‌کنندگان
  detail2Id   String?        // تفصیلی مرکز هزینه یا شناسه سفارش کار
  debit       Decimal        @default(0) @db.Decimal(18, 2)
  credit      Decimal        @default(0) @db.Decimal(18, 2)
  description String?
  rowOrder    Int

  @@index([voucherId])
  @@index([accountId])
  @@index([detail1Id])
}

// ===========================================================
// انبارداری صنعتی چهارگانه، رهگیری باسکول و کاردکس
// ===========================================================

enum WarehouseType {
  RAW_MATERIALS    // انبار مواد اولیه فلزی و مصالح فله
  WORK_IN_PROGRESS // کالای در جریان ساخت پای خطوط
  FINISHED_GOODS   // قطعات ساخته شده آماده بارگیری
  SCRAP            // انبار ضایعات و قراضه
}

model Warehouse {
  id           String             @id @default(uuid())
  code         String             @unique
  name         String
  type         WarehouseType
  transactions StockTransaction[]
}

enum TransactionType {
  PURCHASE_RECEIPT    // رسید خرید با توزین باسکول
  ISSUE_TO_PRODUCTION // حواله خروج به خط تولید
  PRODUCTION_RECEIPT  // رسید قطعه تکمیل‌شده از خط
  DELIVERY_NOTE       // حواله خروج قطعه برای مشتری
  SCRAP_TRANSFER      // انتقال ضایعات برش به انبار قراضه
}

model StockTransaction {
  id           String          @id @default(uuid())
  warehouseId  String
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])
  productId    Int
  product      Product         @relation(fields: [productId], references: [id])
  type         TransactionType
  quantity     Decimal         @db.Decimal(15, 3)
  unitCost     Decimal         @db.Decimal(18, 2) // بهای میانگین موزون متحرک
  totalCost    Decimal         @db.Decimal(18, 2)
  scaleGrossKg Decimal?        @db.Decimal(12, 2) // وزن ناخالص باسکول
  scaleTareKg  Decimal?        @db.Decimal(12, 2) // وزن خالی تریلی (تارا)
  scaleNetKg   Decimal?        @db.Decimal(12, 2) // وزن خالص باسکول
  referenceNo  String?
  createdAt    DateTime        @default(now())

  @@index([warehouseId, productId])
}

// ===========================================================
// مهندسی تولید و سفارش‌های ساخت (Job Costing - MTO/ETO)
// ===========================================================

model BOM {
  id               String            @id @default(uuid())
  productId        Int
  product          Product           @relation("ProductBOM", fields: [productId], references: [id])
  version          Int               @default(1)
  description      String?
  items            BOMItem[]
  productionOrders ProductionOrder[]
}

model BOMItem {
  id            String   @id @default(uuid())
  bomId         String
  bom           BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  rawMaterialId Int
  rawMaterial   Product  @relation(fields: [rawMaterialId], references: [id])
  quantity      Decimal  @db.Decimal(15, 4)
  wastePercent  Decimal  @default(0) @db.Decimal(5, 2) // درصد استاندارد پرت مصالح
}

enum OrderStatus {
  PLANNED
  IN_PRODUCTION
  QUALITY_CONTROL
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id                 String      @id @default(uuid())
  orderNumber        String      @unique // مثال: WO-1403-104
  customerId         Int
  customer           Customer    @relation(fields: [customerId], references: [id])
  bomId              String
  bom                BOM         @relation(fields: [bomId], references: [id])
  targetQuantity     Decimal     @db.Decimal(12, 2)
  actualQuantity     Decimal     @default(0) @db.Decimal(12, 2)
  status             OrderStatus @default(PLANNED)
  actualMaterialCost Decimal     @default(0) @db.Decimal(18, 2)
  actualLaborCost    Decimal     @default(0) @db.Decimal(18, 2)
  actualOverheadCost Decimal     @default(0) @db.Decimal(18, 2)
  finalCostPerUnit   Decimal     @default(0) @db.Decimal(18, 2)
  startDate          DateTime?
  completionDate     DateTime?
  createdAt          DateTime    @default(now())

  @@index([customerId])
}

// ===========================================================
// وضعیت ارسال فاکتور به سامانه مودیان
// ===========================================================

enum TaxSendStatus {
  NOT_SENT
  QUEUED
  IN_PROGRESS
  SUCCESS
  FAILED
}

// ===========================================================
// پرسنل، حقوق و دستمزد و خروجی‌های قانونی (بیمه و مالیات)
// ===========================================================

model Employee {
  id            String        @id @default(uuid())
  personnelCode String        @unique
  nationalCode  String        @unique
  insuranceNo   String?
  firstName     String
  lastName      String
  fatherName    String?
  jobTitle      String
  workshopCode  String        // کد کارگاه تامین اجتماعی
  baseDailyWage Decimal       @db.Decimal(15, 2)
  payslips      PayrollSlip[]
  createdAt     DateTime      @default(now())
}

model PayrollSlip {
  id                String    @id @default(uuid())
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id])
  year              Int
  month             Int
  workedDays        Int
  overtimeHours     Decimal   @default(0) @db.Decimal(6, 2)
  grossSalary       Decimal   @db.Decimal(18, 2)
  insuranceWorker   Decimal   @db.Decimal(18, 2) // ۷٪
  insuranceEmployer Decimal   @db.Decimal(18, 2) // ۲۳٪
  incomeTax         Decimal   @db.Decimal(18, 2) // ماده ۸۶
  netSalary         Decimal   @db.Decimal(18, 2)
  journalVoucherId  String?
  createdAt         DateTime  @default(now())

  @@unique([employeeId, year, month])
}