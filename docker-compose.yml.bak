version: '3.8'

services:
  imgproxy:
    image: darthsim/imgproxy:latest
    container_name: ks_imgproxy
    ports:
      - "127.0.0.1:8080:8080"   # فقط لوکال‌هاست – Nginx هاست از آن استفاده می‌کند
    environment:
      - IMGPROXY_KEY=${IMGPROXY_KEY}
      - IMGPROXY_SALT=${IMGPROXY_SALT}
      - IMGPROXY_MALLOC=jemalloc
      - IMGPROXY_WORKERS=2
      - IMGPROXY_READ_TIMEOUT=30
      - IMGPROXY_WRITE_TIMEOUT=30
      - IMGPROXY_CACHE_MAX_SIZE=1000
      - IMGPROXY_USE_S3=true
      - IMGPROXY_S3_ENDPOINT=${IMGPROXY_S3_ENDPOINT}
      - AWS_ACCESS_KEY_ID=${MINIO_ACCESS_KEY}
      - AWS_SECRET_ACCESS_KEY=${MINIO_SECRET_KEY}
      - IMGPROXY_S3_REGION=us-east-1
    networks:
      - ks_network
    restart: always

  nextjs_app:
    build:
      context: .
      args:
        NEXT_PUBLIC_SITE_URL: ${NEXT_PUBLIC_SITE_URL}
    image: khoshsanatv7-app:latest
    container_name: ks_nextjs
    ports:
      - "127.0.0.1:3000:3000"   # فقط لوکال‌هاست – Nginx هاست پراکسی می‌کند
    environment:
      - NODE_ENV=${NODE_ENV}
      - DATABASE_URL=${DATABASE_URL}
      - IMGPROXY_URL=http://imgproxy:8080
      - IMGPROXY_KEY=${IMGPROXY_KEY}
      - IMGPROXY_SALT=${IMGPROXY_SALT}
      - DOMAIN=${DOMAIN}
      - NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
      - NEXT_PUBLIC_ADMINER_URL=${NEXT_PUBLIC_ADMINER_URL}
      - MINIO_USE_SSL=${MINIO_USE_SSL}
      - MINIO_ENDPOINT=${MINIO_ENDPOINT}
      - MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
      - MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
      - MINIO_BUCKET_NAME=${MINIO_BUCKET_NAME}
      - NEXT_TELEMETRY_DISABLED=1
    depends_on:
      - imgproxy
    networks:
      - ks_network
    restart: always

  adminer:
    image: adminer:latest
    container_name: ks_adminer
    ports:
      - "127.0.0.1:8081:8080"
    environment:
      - ADMINER_DEFAULT_SERVER=${MINIO_ENDPOINT} # میتوانید آی‌پی دیتابیس را به عنوان پیش‌فرض قرار دهید
    networks:
      - ks_network
    restart: always

networks:
  ks_network:
    driver: bridge
    name: ks_network